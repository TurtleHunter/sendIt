<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <style>
    body{margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
    .wrapper{max-width:560px;margin:40px auto;background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.08)}
    .header{padding:28px 32px;background:#1e293b}.header .app-name{color:#f8fafc;font-size:18px;font-weight:600}
    .header img{height:32px}
    .body{padding:32px;color:#374151;font-size:15px;line-height:1.6}
    .body h1{margin:0 0 16px;font-size:20px;color:#111827}
    .body p{margin:0 0 16px}
    .tag{display:inline-block;padding:3px 10px;border-radius:4px;font-size:12px;font-weight:600;background:#fef9c3;color:#854d0e}
    .detail-box{margin:20px 0;padding:16px;background:#f8fafc;border-radius:6px;font-size:14px}
    .detail-box .label{color:#6b7280;font-size:12px;text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px}
    .footer{padding:20px 32px;background:#f8fafc;border-top:1px solid #e5e7eb;font-size:12px;color:#9ca3af}
  </style>
</head>
<body>
<div class="wrapper">
  <div class="header">
    {{#if app.logo_url}}<img src="{{app.logo_url}}" alt="{{app.from_name}}"/>
    {{else}}<span class="app-name">{{app.from_name}}</span>{{/if}}
  </div>
  <div class="body">
    <h1>Access request received <span class="tag">Pending review</span></h1>
    <p>Hi{{#if name}} {{name}}{{/if}}, we've received your request to access <strong>{{app.from_name}}</strong>. A reviewer will look at your request shortly.</p>
    {{#if requestedRoles}}
    <div class="detail-box">
      <div class="label">Requested roles</div>
      {{requestedRoles}}
    </div>
    {{/if}}
    {{#if reason}}
    <div class="detail-box">
      <div class="label">Your reason</div>
      {{reason}}
    </div>
    {{/if}}
    <p>You'll receive another email once your request has been reviewed. No action is needed from you right now.</p>
  </div>
  <div class="footer">
    This is a confirmation of your access request to {{app.from_name}}.
  </div>
</div>
</body>
</html>
