<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <style>
    body{margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
    .wrapper{max-width:560px;margin:40px auto;background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.08)}
    .header{padding:28px 32px;background:#1e293b}.header .app-name{color:#f8fafc;font-size:18px;font-weight:600}
    .header img{height:32px}
    .body{padding:32px;color:#374151;font-size:15px;line-height:1.6}
    .body h1{margin:0 0 16px;font-size:20px;color:#111827}
    .body p{margin:0 0 16px}
    .btn{display:inline-block;margin-top:8px;padding:12px 24px;background:#2563eb;color:#fff!important;text-decoration:none;border-radius:6px;font-weight:600;font-size:14px}
    .notice{margin-top:20px;padding:12px 16px;background:#f8fafc;border-left:3px solid #d1d5db;font-size:13px;color:#6b7280;border-radius:0 4px 4px 0}
    .footer{padding:20px 32px;background:#f8fafc;border-top:1px solid #e5e7eb;font-size:12px;color:#9ca3af}
  </style>
</head>
<body>
<div class="wrapper">
  <div class="header">
    {{#if app.logo_url}}<img src="{{app.logo_url}}" alt="{{app.from_name}}"/>
    {{else}}<span class="app-name">{{app.from_name}}</span>{{/if}}
  </div>
  <div class="body">
    <h1>You've been invited</h1>
    <p>{{#if invitedBy}}<strong>{{invitedBy}}</strong> has invited you to{{else}}You've been invited to{{/if}}
    access <strong>{{app.from_name}}</strong>.</p>
    {{#if message}}<p>{{message}}</p>{{/if}}
    <p>Click the button below to accept your invitation and register your certificate. This link expires in <strong>{{expiresIn}}</strong>.</p>
    <a class="btn" href="{{inviteUrl}}">Accept Invitation</a>
    <div class="notice">
      <strong>Certificate required.</strong> Make sure your client certificate is installed before clicking the link above.
    </div>
  </div>
  <div class="footer">
    If you weren't expecting this invitation, you can ignore this email. The link will expire automatically.
  </div>
</div>
</body>
</html>
