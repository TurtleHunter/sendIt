<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <style>
    body{margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
    .wrapper{max-width:560px;margin:40px auto;background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.08)}
    .header{padding:28px 32px;background:#1e293b}.header .app-name{color:#f8fafc;font-size:18px;font-weight:600}
    .header img{height:32px}
    .body{padding:32px;color:#374151;font-size:15px;line-height:1.6}
    .body h1{margin:0 0 16px;font-size:20px;color:#111827}
    .body p{margin:0 0 16px}
    .tag{display:inline-block;padding:3px 10px;border-radius:4px;font-size:12px;font-weight:600;background:#dcfce7;color:#166534}
    .btn{display:inline-block;margin-top:8px;padding:12px 24px;background:#2563eb;color:#fff!important;text-decoration:none;border-radius:6px;font-weight:600;font-size:14px}
    .roles{margin:16px 0;padding:12px 16px;background:#f0fdf4;border-left:3px solid #22c55e;border-radius:0 4px 4px 0;font-size:14px}
    .footer{padding:20px 32px;background:#f8fafc;border-top:1px solid #e5e7eb;font-size:12px;color:#9ca3af}
  </style>
</head>
<body>
<div class="wrapper">
  <div class="header">
    {{#if app.logo_url}}<img src="{{app.logo_url}}" alt="{{app.from_name}}"/>
    {{else}}<span class="app-name">{{app.from_name}}</span>{{/if}}
  </div>
  <div class="body">
    <h1>Access approved <span class="tag">✓ Approved</span></h1>
    <p>Hi{{#if name}} {{name}}{{/if}}, your request to access <strong>{{app.from_name}}</strong> has been approved.</p>
    {{#if grantedRoles}}
    <div class="roles">
      <strong>Roles granted:</strong> {{grantedRoles}}
    </div>
    {{/if}}
    {{#if grantedGroups}}
    <div class="roles">
      <strong>Groups assigned:</strong> {{grantedGroups}}
    </div>
    {{/if}}
    {{#if reviewerNote}}
    <p><em>"{{reviewerNote}}"</em></p>
    {{/if}}
    <a class="btn" href="{{app.base_url}}">Go to {{app.from_name}}</a>
  </div>
  <div class="footer">
    Your access was approved for {{app.from_name}}. If you have questions, contact your administrator.
  </div>
</div>
</body>
</html>
