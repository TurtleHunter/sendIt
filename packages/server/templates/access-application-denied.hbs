<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <style>
    body{margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
    .wrapper{max-width:560px;margin:40px auto;background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.08)}
    .header{padding:28px 32px;background:#1e293b}.header .app-name{color:#f8fafc;font-size:18px;font-weight:600}
    .header img{height:32px}
    .body{padding:32px;color:#374151;font-size:15px;line-height:1.6}
    .body h1{margin:0 0 16px;font-size:20px;color:#111827}
    .body p{margin:0 0 16px}
    .tag{display:inline-block;padding:3px 10px;border-radius:4px;font-size:12px;font-weight:600;background:#fee2e2;color:#991b1b}
    .reason{margin:16px 0;padding:12px 16px;background:#fef2f2;border-left:3px solid #ef4444;border-radius:0 4px 4px 0;font-size:14px}
    .footer{padding:20px 32px;background:#f8fafc;border-top:1px solid #e5e7eb;font-size:12px;color:#9ca3af}
  </style>
</head>
<body>
<div class="wrapper">
  <div class="header">
    {{#if app.logo_url}}<img src="{{app.logo_url}}" alt="{{app.from_name}}"/>
    {{else}}<span class="app-name">{{app.from_name}}</span>{{/if}}
  </div>
  <div class="body">
    <h1>Access request denied <span class="tag">Denied</span></h1>
    <p>Hi{{#if name}} {{name}}{{/if}}, your request to access <strong>{{app.from_name}}</strong> has been reviewed and was not approved at this time.</p>
    {{#if reviewerNote}}
    <div class="reason">
      <strong>Reviewer note:</strong> {{reviewerNote}}
    </div>
    {{/if}}
    <p>If you believe this is an error or would like to discuss further, please contact your administrator directly.</p>
  </div>
  <div class="footer">
    This decision was made by an administrator of {{app.from_name}}.
  </div>
</div>
</body>
</html>
