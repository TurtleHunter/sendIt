<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <style>
    body { margin: 0; padding: 0; background: #f4f4f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
    .wrapper { max-width: 560px; margin: 40px auto; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
    .header { padding: 28px 32px; background: #1e293b; }
    .header img { height: 32px; }
    .header .app-name { color: #f8fafc; font-size: 18px; font-weight: 600; }
    .body { padding: 32px; color: #374151; font-size: 15px; line-height: 1.6; }
    .body h1 { margin: 0 0 16px; font-size: 20px; color: #111827; }
    .body p { margin: 0 0 16px; }
    .btn { display: inline-block; margin-top: 8px; padding: 12px 24px; background: #2563eb; color: #ffffff !important; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 14px; }
    .footer { padding: 20px 32px; background: #f8fafc; border-top: 1px solid #e5e7eb; font-size: 12px; color: #9ca3af; }
    .tag { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; }
    .tag-approved { background: #dcfce7; color: #166534; }
    .tag-denied   { background: #fee2e2; color: #991b1b; }
    .tag-pending  { background: #fef9c3; color: #854d0e; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      {{#if app.logo_url}}
        <img src="{{app.logo_url}}" alt="{{app.from_name}}" />
      {{else}}
        <span class="app-name">{{app.from_name}}</span>
      {{/if}}
    </div>
    <div class="body">
      {{{content}}}
    </div>
    <div class="footer">
      You received this email because an action was taken on your account at {{app.from_name}}.
      If you weren't expecting this, you can ignore it.
    </div>
  </div>
</body>
</html>
