{
	"name": "@sendit/server",
	"version": "1.0.0",
	"description": "Internal email microservice for cert-authed Helm-deployed webapps",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsup",
		"start": "node dist/index.js",
		"dev": "tsup --watch & node --watch dist/index.js",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"express": "^4.18.2",
		"handlebars": "^4.7.8",
		"nodemailer": "^6.9.9",
		"pg": "^8.11.3"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/handlebars": "^4.0.40",
		"@types/node": "^25.5.0",
		"@types/nodemailer": "^7.0.11",
		"@types/pg": "^8.18.0",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0"
	}
}
