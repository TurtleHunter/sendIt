{
	"name": "@sendit/client",
	"version": "1.0.0",
	"description": "Type-safe client for the sendIt email service",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"tsup": "^8.0.0",
		"typescript": "^5.4.0",
		"@types/node": "^20.0.0"
	}
}
